generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["crossyield"]
}

model User {
  id         String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  authEvents AuthEvent[]
  intents    Intent[]
  wallets    Wallet[]

  @@schema("crossyield")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  address   String   @unique
  chain     String
  chainId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@schema("crossyield")
}

model Intent {
  id              String         @id @default(uuid())
  userId          String
  token           String
  amount          Float
  riskTolerance   String
  minApy          Float
  preferredChains String[]
  fromChain      String
  toChain        String
  autoExecute     Boolean
  status          String         @default("pending")
  hashlock        String?
  secret          String?
  timelock        DateTime?
  isRefunded      Boolean?
  isRedeemed      Boolean?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  expiresAt       DateTime?
  executedAt      DateTime?
  apyResults      APYResult[]
  executionLogs   ExecutionLog[]
  htlc            HTLC?
  user            User           @relation(fields: [userId], references: [id])

  @@schema("crossyield")
}

model HTLC {
  id           String         @id @default(uuid())
  intentId     String         @unique
  hashlock     String
  secret       String?
  timelock     DateTime
  redeemedAt   DateTime?
  refundedAt   DateTime?
  isRefunded   Boolean        @default(false)
  isRedeemed   Boolean        @default(false)
  chain        String
  unlockTxHash String?
  executions   ExecutionLog[]
  intent       Intent         @relation(fields: [intentId], references: [id])

  @@schema("crossyield")
}

model APYResult {
  id         String    @id @default(uuid())
  intentId   String
  token      String
  apy        Float
  tvlUsd     Float
  project    String
  chain      String
  riskScore  Float?
  protocolId String?
  intent     Intent    @relation(fields: [intentId], references: [id])
  protocol   Protocol? @relation(fields: [protocolId], references: [id])

  @@schema("crossyield")
}

model Protocol {
  id        String      @id @default(uuid())
  name      String
  chain     String
  website   String?
  riskScore Float?
  apys      APYResult[]

  @@schema("crossyield")
}

model ExecutionLog {
  id         String   @id @default(uuid())
  intentId   String
  executedBy String
  txHash     String
  chain      String
  gasUsed    Float
  executedAt DateTime @default(now())
  status     String   @default("success")
  htlcId     String?
  htlc       HTLC?    @relation(fields: [htlcId], references: [id])
  intent     Intent   @relation(fields: [intentId], references: [id])

  @@schema("crossyield")
}

model AuthEvent {
  id          String   @id @default(uuid())
  userId      String
  loginMethod String
  ipAddress   String?
  loggedInAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@schema("crossyield")
}
